#!/usr/bin/env php
<?php

declare(strict_types=1);

use KeyboardManiaInputToVirtualMidi\KeyboardManiaInputToVirtualMidi;

$autoloadPath = dirname(__DIR__) . '/vendor/autoload.php';

if (!is_file($autoloadPath)) {
    fwrite(STDERR, "Composer autoload not found. Run: composer install\n");
    exit(1);
}

require $autoloadPath;

$devicePath = $argv[1] ?? '/dev/input/js0';
$configPath = $argv[2] ?? dirname(__DIR__) . '/config/keymap.json';

$configJson = file_get_contents($configPath);

if ($configJson === false) {
    fwrite(STDERR, "Failed to read config: {$configPath}\n");
    exit(1);
}

$config = json_decode($configJson, true);

if (!is_array($config)) {
    fwrite(STDERR, "Invalid config JSON: {$configPath}\n");
    exit(1);
}

try {
    $app = new KeyboardManiaInputToVirtualMidi($devicePath, $config);
    $app->run();
} catch (Throwable $e) {
    fwrite(STDERR, $e->getMessage() . "\n");
    exit(1);
}
